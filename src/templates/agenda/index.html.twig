{% extends 'base.html.twig' %}

{% block title %}Agenda scolaire{% endblock %}

{% block body %}
<div class="container-fluid wrapper">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">🗓️ Agenda scolaire</h5>
                    <a href="{{ path('app_agenda_create') }}" class="btn btn-light btn-sm">
                        ➕ Ajouter un événement
                    </a>
                </div>

                <div class="card-body">
                    <div id="agenda_corps" class="fc fc-theme-bootstrap5">
                        <!-- FullCalendar will be injected here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Inputs cachés pour JS -->
    <input type="hidden" id="action" value="agenda_corps">
    <input type="hidden" id="agenda-data" value="{{ agenda|e('html_attr') }}">
    <input type="hidden" id="token" value="{{ csrf_token('create-time') }}">
    <input type="hidden" id="token_info_utilisateur" value="{{ csrf_token('info_data_eleve') }}">
</div>
{% endblock %}

{% block extraJs %}
    {{ encore_entry_script_tags('agenda') }}
    {{ encore_entry_script_tags('agenda_action') }}
{% endblock %}
