{% extends 'base.html.twig' %}

{% block title %}Créer un événement{% endblock %}

{% block body %}
<main class="container my-4">
    <section class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h1 class="h3 mb-0">Créer un événement</h1>
        </div>
        <div class="card-body">
            <form method="post" action="{{ path('app_agenda_post') }}">
                <input type="hidden" name="create-time" value="{{ csrf_token('create-time') }}">

                <!-- Élève -->
                <div class="mb-3">
                    <label for="eleve" class="form-label fw-bold">Élève</label>
                    <select name="eleve" id="eleve" class="form-select" multiple>

                    </select>
                    <div class="form-text">Vous pouvez saisir un nom ou en sélectionner plusieurs dans la liste ci-dessus.</div>
                </div>

                <!-- Classe -->
                <div class="mb-3">
                    <label for="classe" class="form-label fw-bold">Classe</label>
                    <select name="classe" id="classe" class="form-select" multiple>
                        <option value="-1">Toutes les classes</option>
                        {% for classe in classes %}
                            <option value="{{ classe.id }}">{{ classe.nom }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">Filtrez ou choisissez plusieurs classes grâce au champ de recherche intégré.</div>
                </div>
                
                <!-- Sujet -->
                <div class="mb-3">
                    <label for="sujet" class="form-label fw-bold">Sujet de l’événement</label>
                    <input name="sujet" id="sujet" class="form-control" required>
                </div>

                <!-- Objet -->
                <div class="mb-3">
                    <label for="data" class="form-label fw-bold">Objet de l’événement</label>
                    <textarea name="data" id="data" class="form-control" rows="3" required></textarea>
                </div>

                <!-- Lieu de l'évènement-->
                <div class="mb-3">
                    <label for="lieu" class="form-label fw-bold">Lieu de l'évènement</label>
                    <input name="lieu" id="lieu" class="form-control">
                </div>

                <!-- Début -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Début</label>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input type="date" name="dateDebut" id="dateDebut" class="form-control" value="2025-06-12" required>
                        </div>
                        <div class="col-md-6">
                            <input type="time" name="heureDebut" id="heureDebut" class="form-control" value="19:30" required>
                        </div>
                    </div>
                </div>

                <!-- Fin -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Fin</label>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input type="date" name="dateFin" id="dateFin" class="form-control" value="2025-06-12" required>
                        </div>
                        <div class="col-md-6">
                            <input type="time" name="heureFin" id="heureFin" class="form-control" value="19:30" required>
                        </div>
                    </div>
                </div>

                <!-- Reccurence -->
                <div class="mb-3">
                    <label for="reccurence" class="form-label fw-bold">Reccurence</label>
                    <select name="reccurence" id="reccurence" class="form-select">
                    </select>
                </div>


                <input type="hidden" name="token_info_utilisateur" id="token_info_utilisateur" value="{{ csrf_token('info_data_eleve') }}">
                <input type="hidden" name="token_info_utilisateur" id="token_info_utilisateur" value="{{ csrf_token('create-time') }}">

                <!-- Bouton -->
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="bi bi-calendar-plus me-2"></i>Créer l’événement
                    </button>
                </div>
            </form>
        </div>
    </section>
</main>
{% endblock %}

{% block extraJs %}
    {{ encore_entry_script_tags('agenda_create') }}
{% endblock %}
