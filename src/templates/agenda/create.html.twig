{% extends 'base.html.twig' %}

{% block title %}Créer un événement{% endblock %}

{% block body %}
<main class="container my-4">
    <section class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h1 class="h3 mb-0">Créer un événement</h1>
        </div>
        <div class="card-body">
            {{ form_start(form) }}

                <!-- Élève -->
                <div class="mb-3">
                    <label for="eleve" class="form-label fw-bold">Élève</label>
                    <select name="eleve" id="eleve" class="form-select" multiple>

                    </select>
                    <div class="form-text">Vous pouvez saisir un nom ou en sélectionner plusieurs dans la liste ci-dessus.</div>
                </div>

                <!-- Classe -->
                <div class="mb-3">
                    <label for="classe" class="form-label fw-bold">Classe</label>
                    <select name="classe" id="classe" class="form-select" multiple>
                        <option value="-1">Toutes les classes</option>
                        {% for classe in classes %}
                            <option value="{{ classe.id }}">{{ classe.nom }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">Filtrez ou choisissez plusieurs classes grâce au champ de recherche intégré.</div>
                </div>
                
                <!-- Sujet -->
                <div class="mb-3">
                    {{ form_label(form.sujet) }}
                    {{ form_widget(form.sujet, {'attr': {'class': 'form-control'}}) }}
                </div>

                <!-- Description -->
                <div class="mb-3">
                    {{ form_label(form.corps) }}
                    {{ form_widget(form.corps, {'attr': {'class': 'form-control'}}) }}
                </div>

                <!-- Lieu -->
                <div class="mb-3">
                    {{ form_label(form.lieu) }}
                    {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
                </div>

                <!-- Début -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Début</label>
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input type="date" name="dateDebut" id="dateDebut" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <input type="time" name="heureDebut" id="heureDebut" class="form-control" required>
                        </div>
                    </div>
                </div>

                <!-- Durée -->
                <div class="mb-3">
                    {{ form_label(form.duree) }}
                    {{ form_widget(form.duree, {'attr': {'class': 'form-control'}}) }}
                </div>

                <!-- Récurrence -->
                <div class="mb-3">
                    {{ form_label(form.recurrence) }}
                    {{ form_widget(form.recurrence, {'attr': {'class': 'form-select'}}) }}
                </div>

                <!-- Bouton -->
                <div class="d-grid">
                    {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
                </div>

            {{ form_end(form) }}
        </div>
    </section>
</main>
{% endblock %}

{% block extraJs %}
    {{ encore_entry_script_tags('agenda_create') }}
{% endblock %}
