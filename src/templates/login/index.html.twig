{% extends 'base.html.twig' %}

{% block title %}Page de connexion{% endblock %}

{% block body %}
<section class="container py-5" style="max-width: 420px;">
    
    {% if error %}
        <div class="alert alert-danger text-center mb-4">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <div class="card shadow-sm">
        <div class="card-body p-4">

            <h1 class="h4 text-center fw-bold mb-4">Connexion</h1>

            <form action="{{ path('app_login') }}" method="post" class="login-form">

                <div class="mb-3">
                    <label for="username" class="form-label fw-semibold">Email</label>
                    <input 
                        type="text"
                        id="username"
                        name="_username"
                        class="form-control"
                        value="{{ last_username }}"
                        placeholder="Votre email"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label fw-semibold">Mot de passe</label>
                    <input 
                        type="password"
                        id="password"
                        name="_password"
                        class="form-control"
                        placeholder="Votre mot de passe"
                        autocomplete="current-password"
                        required
                    >
                </div>

                <button type="submit" class="btn btn-primary w-100 mt-3">
                    Se connecter
                </button>

            </form>

        </div>
    </div>
</section>
{% endblock %}
